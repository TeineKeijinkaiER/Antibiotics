{
  "name": "antibiotics-navi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build && node scripts/make-sw.mjs",
    "preview": "vite preview",
    "validate": "node scripts/validate-data.mjs && node scripts/check-antibiogram-consistency.mjs",
    "icons": "node scripts/make-icons.mjs",
    "antibiogram:check": "node scripts/check-antibiogram-consistency.mjs",
    "antibiogram:sheet": "node scripts/make-checksheet.mjs",
    "antibiogram:corrections": "node scripts/apply-corrections.mjs",
    "antibiogram:diff": "node scripts/diff-antibiogram.mjs",
    "typecheck": "tsc -b --noEmit",
    "check:layout": "node scripts/check-layout.mjs",
    "check:tdm": "node scripts/check-tdm.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
